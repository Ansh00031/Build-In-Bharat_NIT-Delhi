# LLM API Configuration (Supports Google Gemini, OpenAI, Groq, or Local Ollama)
# For Google Gemini:
OPENAI_API_KEY=your_gemini_api_key_here
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-flash-latest

# For OpenAI:
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o

# For Local Ollama (100% Free & Offline):
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3

# Algorand TestNet Configuration (AlgoKit Lora Explorer: https://lora.algokit.io/testnet)
# Generated automatically by 'python agent.py blockchain status' if left blank
ALGORAND_MNEMONIC=
ALGORAND_ALGOD_URL=https://testnet-api.algonode.cloud
